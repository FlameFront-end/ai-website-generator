# Runtime mode for NestJS/Node. Use development locally, production in Docker/prod.
NODE_ENV=development

# ─── HTTP / CORS ─────────────────────────────────────────────
# Internal API port used by NestJS.
API_PORT=3000

# Host port exposed by Docker for the API, if docker-compose maps it.
API_PUBLIC_PORT=3001

# Browser origin allowed by CORS.
# Local Vite dev server: http://localhost:5173
# Docker nginx client can be exposed as: http://localhost:8080
CLIENT_ORIGIN=http://localhost:5173

# ─── PostgreSQL ──────────────────────────────────────────────
# Use localhost for local DB, postgres for docker-compose service DNS.
DB_HOST=localhost
DB_PORT=5432
DB_PUBLIC_PORT=5434
DB_USER=postgres
DB_PASSWORD=2004
DB_NAME=ai_website_generator

# true is convenient for local MVP/dev. Use migrations and false in production.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Optional full connection string. If set, it overrides DB_HOST/DB_PORT/etc.
# DATABASE_URL=postgresql://postgres:2004@localhost:5432/ai_website_generator

# ─── Redis ───────────────────────────────────────────────────
# Use localhost for local Redis, redis for docker-compose service DNS.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PUBLIC_PORT=6379

# ─── Client / Vite ───────────────────────────────────────────
# Internal client port. In Docker/nginx this is usually 80; in local Vite dev it is 5173.
CLIENT_PORT=5173
CLIENT_PUBLIC_PORT=8080

# API base URL compiled into the Vite client.
# Docker/nginx reverse proxy: /api
# Local separate dev servers: http://localhost:3000/api
VITE_API_URL=http://localhost:3000/api

# ─── Generated Files ─────────────────────────────────────────
# Directory where generated project artifacts are written.
# In Docker this points to the container path; locally use generated.
GENERATED_ROOT=generated

# ─── Auth ────────────────────────────────────────────────────
# JWT secret for login sessions. Replace with a long random value outside local dev.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ─── AI Orchestration By Role ────────────────────────────────
# Configure each AI role explicitly.
# Chat providers: lmstudio | openai | openrouter | llm7
# Image provider: replicate
# Base URL examples:
# LM Studio:  http://localhost:1234/v1
# OpenAI:     https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# LLM7.io:    https://api.llm7.io/v1
#
# API key:
# LM Studio usually does not need a key.
# LLM7 token: https://token.llm7.io
# Replicate token: https://replicate.com/account/api-tokens
#
# Model examples:
# LM Studio: leave empty to use the loaded local model.
# OpenAI: gpt-4o, gpt-4o-mini
# OpenRouter: anthropic/claude-sonnet-4, openai/gpt-4o
# LLM7: gpt-4, gpt-3.5-turbo
# Replicate image model: black-forest-labs/flux-2-pro
#
# STRICT_JSON sends response_format=json_object when true.
# LLM7 free plan returns 402 for strict JSON, so set false when using LLM7 free.
#
# analysis: brief clarification, project spec, design tokens, design description.
# image: real image generation through Replicate / FLUX.
# code: React/CSS code generation.

AI_ANALYSIS_PROVIDER=lmstudio
AI_ANALYSIS_BASE_URL=http://localhost:1234/v1
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_MODEL=
AI_ANALYSIS_TIMEOUT=120000
AI_ANALYSIS_STRICT_JSON=

AI_IMAGE_PROVIDER=replicate
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=black-forest-labs/flux-2-pro
AI_IMAGE_TIMEOUT=120000
AI_IMAGE_STRICT_JSON=

AI_CODE_PROVIDER=lmstudio
AI_CODE_BASE_URL=http://localhost:1234/v1
AI_CODE_API_KEY=
AI_CODE_MODEL=
AI_CODE_TIMEOUT=120000
AI_CODE_STRICT_JSON=
