# Local PostgreSQL service is expected on 127.0.0.1:5432.
# If you create the database manually in pgAdmin, use the same DB_NAME there.
# docker-compose PostgreSQL is exposed on 127.0.0.1:5434 as an optional fallback.
API_PORT=3000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=2004
DB_NAME=ai_website_generator
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Optional override:
# DATABASE_URL=postgresql://postgres:2004@localhost:5432/ai_website_generator

REDIS_HOST=localhost
REDIS_PORT=6379

CLIENT_PORT=5173
VITE_API_URL=http://localhost:3000/api

GENERATED_ROOT=generated/runs

# Add provider keys when AI generation is implemented.
AI_API_KEY=
