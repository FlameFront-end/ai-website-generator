# Локальный PostgreSQL ожидается на 127.0.0.1:5432.
# Если база создается вручную в pgAdmin, используйте значение DB_NAME.
# PostgreSQL из docker-compose доступен на 127.0.0.1:5434 как запасной вариант.
API_PORT=3000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=2004
DB_NAME=ai_website_generator
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Опциональное переопределение:
# DATABASE_URL=postgresql://postgres:2004@localhost:5432/ai_website_generator

REDIS_HOST=localhost
REDIS_PORT=6379

CLIENT_PORT=5173
VITE_API_URL=http://localhost:3000/api

GENERATED_ROOT=generated/runs

# Ключи провайдеров понадобятся после подключения ИИ-генерации.
AI_API_KEY=
