# local or docker. Derived defaults live in app/server/src/app/config.ts.
APP_ENV=local

# HTTP
API_PORT=3000
API_PUBLIC_PORT=3001

# PostgreSQL
DB_PORT=5432
DB_PUBLIC_PORT=5434
DB_USER=postgres
DB_PASSWORD=2004
DB_NAME=ai_website_generator
DB_SYNCHRONIZE=false
DB_LOGGING=false
# DATABASE_URL=postgresql://postgres:2004@localhost:5432/ai_website_generator

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PUBLIC_PORT=6379

# Client
CLIENT_PUBLIC_PORT=8080

# Auth (JWT_SECRET is required in production — no default is provided when NODE_ENV=production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI: chat providers lmstudio | openai | openrouter | llm7. Image provider: openai.
AI_ANALYSIS_PROVIDER=lmstudio
AI_ANALYSIS_BASE_URL=http://localhost:1234/v1
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_MODEL=
AI_ANALYSIS_TIMEOUT=120000
AI_ANALYSIS_STRICT_JSON=

AI_IMAGE_PROVIDER=openai
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-5.5
AI_IMAGE_TIMEOUT=300000
AI_IMAGE_STRICT_JSON=

AI_CODE_PROVIDER=lmstudio
AI_CODE_BASE_URL=http://localhost:1234/v1
AI_CODE_API_KEY=
AI_CODE_MODEL=
AI_CODE_TIMEOUT=120000
AI_CODE_STRICT_JSON=

# Rate limiting (requests per TTL window in seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=60
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=10

CODE_QUALITY_REFERENCE_URL=
