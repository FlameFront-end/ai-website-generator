# Локальный PostgreSQL ожидается на 127.0.0.1:5432.
# Если база создается вручную в pgAdmin, используйте значение DB_NAME.
# PostgreSQL из docker-compose доступен на 127.0.0.1:5434 как запасной вариант.
API_PORT=3000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=2004
DB_NAME=ai_website_generator
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Опциональное переопределение:
# DATABASE_URL=postgresql://postgres:2004@localhost:5432/ai_website_generator

REDIS_HOST=localhost
REDIS_PORT=6379

CLIENT_PORT=5173
VITE_API_URL=http://localhost:3000/api

GENERATED_ROOT=generated

# JWT секрет для авторизации (измените в production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ─── AI Provider ─────────────────────────────────────────────
# Провайдер: lmstudio | openai | openrouter | llm7
AI_PROVIDER=llm7

# LM Studio (по умолчанию): http://localhost:1234/v1
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# LLM7.io: https://api.llm7.io/v1
AI_BASE_URL=http://localhost:1234/v1

# API-ключ (для LM Studio обычно не нужен, для остальных обязателен)
# LLM7.io: бесплатный токен с https://token.llm7.io
AI_API_KEY=

# Модель (оставьте пустым для LM Studio — он использует загруженную модель)
# OpenAI: gpt-4o, gpt-4o-mini
# OpenRouter: anthropic/claude-sonnet-4, openai/gpt-4o
# LLM7.io: gpt-4, gpt-3.5-turbo и др.
AI_MODEL=

# Таймаут запроса к AI в мс (по умолчанию 120000)
AI_TIMEOUT=120000
